# ============================================================================
# Agent Console 环境变量示例
# 复制为 .env 并按需修改;.env 已被 .gitignore 排除,严禁提交真实值。
# 生产环境所有敏感项从 secret/环境注入,不写入仓库与日志。
# ============================================================================

# Relay 主数据库连接串(独立数据库与独立用户,不复用 dev-toolbox 的库和用户)。
# 本机直跑 relay 调试时用此地址(需先在 deploy/compose.yaml 中临时放开 5433 端口映射)。
RELAY_DATABASE_URL=postgres://agent_console:CHANGE_ME@127.0.0.1:5433/agent_console

# 仅供 deploy/compose.yaml 开发库容器初始化使用,与 RELAY_DATABASE_URL 中的密码保持一致。
POSTGRES_PASSWORD=CHANGE_ME

# Relay 监听地址(默认仅本机回环;容器内由 compose 覆盖为 0.0.0.0:8081)
RELAY_BIND_ADDR=127.0.0.1:8081

# 与 dev-toolbox 共享的内部服务 Token(用于 relay <-> dev-toolbox 内部接口互信)。
# 生产环境必须从 secret 注入;禁止写入仓库、日志或测试快照。
RELAY_INTERNAL_TOKEN=

# dev-toolbox 内部服务基地址(ticket 原子消费、auth session introspection 等)
DEVTOOLBOX_INTERNAL_BASE_URL=http://127.0.0.1:8080

# dev-toolbox 对外站点 origin(CORS / 登录回跳 / deep link 校验用)
DEVTOOLBOX_PUBLIC_ORIGIN=https://toolbox.example.com

# Relay 对外的 WebSocket 路径(经反向代理后的公开同域路径)
RELAY_PUBLIC_WS_PATH=/agent-console/ws

# Mac Bridge 连接的 Relay 公网基地址(origin;经 dev-toolbox 网关同域进入)。
# 注意:只填基地址,不带 /agent-console/... 路径 —— Bridge WS(/agent-console/bridge/ws)、
# 配对(/agent-console/bridge/pairing/*)与文件传输(/agent-console/transfers/*)等
# 端点路径由 Bridge 统一派生(见 apps/bridge/src/config/mod.rs 的 RelayUrls)。
# 本地直跑 relay 时用 http://127.0.0.1:8081。
AGENT_CONSOLE_RELAY_URL=https://toolbox.example.com

# Bridge 本地数据目录(Bridge SQLite、上传临时目录等;留空时由 directories crate
# 解析为用户应用数据目录,macOS 默认 ~/Library/Application Support/agent-console/bridge)
AGENT_CONSOLE_DATA_DIR=

# Bridge 其余可选环境变量:AGENT_CONSOLE_CODEX_HOME(默认 ~/.codex)、
# AGENT_CONSOLE_IPC_SOCKET(默认由 owner 发现动态定位)、AGENT_CONSOLE_DEVICE_NAME(默认 Agent Console Bridge)

# Web Push VAPID 私钥文件路径(生产从 secret 挂载,不入仓库;文件权限仅限当前用户)
VAPID_PRIVATE_KEY_FILE=/etc/agent-console/secrets/vapid_private_key.pem
